# Públicas (protegidas por RLS). NÃO coloque service_role nem chave de IA aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Usado só pelo script db:types (CLI), fora do bundle do app
SUPABASE_PROJECT_ID=seu-project-id

# RevenueCat — chave pública do SDK Android (iOS entra quando a conta Apple existir)
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_suachaveaqui
