# Somente para configurar secrets no painel/CLI do Supabase.
# Nunca copie estes valores para .env do Expo, EXPO_PUBLIC_*, Git ou logs.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Base64 de 32 bytes criptograficamente aleatórios. Protege tokens Strava.
INTEGRATION_ENCRYPTION_KEY=
STRAVA_INTEGRATION_ENABLED=false
STRAVA_ACTIVITY_ENRICHMENT_ENABLED=false
