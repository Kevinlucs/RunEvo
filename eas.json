{
  "cli": {
    "version": ">= 21.7.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "hooks": {
        "onBuild": "./eas-hooks/eas-build-on-build.sh"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "hooks": {
        "onBuild": "./eas-hooks/eas-build-on-build.sh"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
